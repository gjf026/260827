<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_520"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:id="@+id/passwordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/vs_20"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/vs_10"
                android:text="密码："
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24" />

            <com.github.tvbox.osc.ui.dialog.PasswordEditText
                android:id="@+id/passwordInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="请输入4~8位数字"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:maxLines="1"
                android:nextFocusDown="@id/passwordConfirm"
                android:paddingLeft="@dimen/vs_10"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_10"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/passwordConfirm"
                android:layout_width="@dimen/vs_100"
                android:layout_height="@dimen/vs_60"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/passwordInput"
                android:nextFocusDown="@id/passwordCancel"
                android:text="确认"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/passwordCancel"
                android:layout_width="@dimen/vs_100"
                android:layout_height="@dimen/vs_60"
                android:layout_marginLeft="@dimen/vs_10"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/passwordConfirm"
                android:text="取消"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passwordKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
